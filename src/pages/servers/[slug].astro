---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstallationGuide from '../../components/server/InstallationGuide.astro';
import DocumentedSequentialThinking from '../../components/server/DocumentedSequentialThinking.astro';
import SecurityChecklist from '../../components/server/SecurityChecklist.astro';
import {getServers,validateRegistry,type RegistryServer} from '../../lib/registry';
const registryErrors=validateRegistry();
if(registryErrors.length) throw new Error('Invalid MCP registry: '+registryErrors.join('; '));
export function getStaticPaths(){return getServers().map(server=>({params:{slug:server.id},props:{server}}));}
interface Props {server:RegistryServer}
const {server}=Astro.props;
---
<BaseLayout title={server.name+' — FreeMCP'} description={server.description}><div class="container detail"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/v2-preview">Explore</a><span aria-hidden="true"> / </span><span>{server.name}</span></nav><div class="intro"><div class="eyebrow">{server.category} · OPEN SOURCE LISTING</div><h1>{server.name}</h1><p>{server.description}</p><div class="actions"><a class="primary" href={server.githubUrl} target="_blank" rel="noopener noreferrer">View source repository ↗</a><a class="secondary" href="/v2-preview">← Back to registry</a></div></div><div class="detail-grid"><div class="content"><section id="overview"><h2>Overview</h2><p>{server.description}</p><h3>Related topics</h3><div class="tags">{server.tags.map(tag=><span>{tag}</span>)}</div></section><section id="installation"><h2>Installation</h2>{server.id==='sequential-thinking-mcp'?<DocumentedSequentialThinking/>:<InstallationGuide repositoryUrl={server.githubUrl} serverName={server.name}/>}</section><section id="tools"><h2>Tools and compatibility</h2><p>Tool definitions, supported transports, and AI-client compatibility have not yet been verified. Consult the project's documentation before enabling access.</p></section><section id="security"><h2>Security and permissions</h2><SecurityChecklist repositoryUrl={server.githubUrl}/></section></div><aside aria-label="Server metadata"><h2>Repository details</h2><dl><dt>Maintainer</dt><dd>{server.author}</dd><dt>Category</dt><dd>{server.category}</dd><dt>GitHub stars</dt><dd>{server.stars.toLocaleString('en-US')} <small>(stored value; may be outdated)</small></dd><dt>License</dt><dd>Not independently verified</dd><dt>Review status</dt><dd>Unverified</dd></dl><a href={server.githubUrl} target="_blank" rel="noopener noreferrer">Repository ↗</a></aside></div></div></BaseLayout>
<style>.detail{padding-top:35px}.breadcrumbs{font-size:12px;color:var(--muted)}.breadcrumbs a{color:var(--accent)}.intro{padding:55px 0;border-bottom:1px solid var(--border)}.eyebrow{color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.13em}h1{font-size:clamp(35px,5vw,56px);letter-spacing:-.06em;margin:16px 0}p{color:var(--muted);line-height:1.75}.intro>p{max-width:750px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.actions a{padding:12px 16px;border-radius:9px;text-decoration:none;font-size:13px;font-weight:700}.primary{background:var(--text);color:var(--bg)}.secondary{border:1px solid var(--border)}.detail-grid{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:45px;padding-top:35px}.content section{padding:20px 0 32px;border-bottom:1px solid var(--border)}h2{font-size:22px;letter-spacing:-.03em}.content a,aside a{color:var(--accent)}.tags{display:flex;flex-wrap:wrap;gap:8px}.tags span{background:var(--surface);padding:7px 10px;border:1px solid var(--border);border-radius:6px;font-size:12px}.notice{padding:18px;border:1px solid var(--border);border-radius:10px;background:var(--surface)}.notice p{font-size:13px}aside{align-self:start;position:sticky;top:95px;border:1px solid var(--border);border-radius:12px;padding:20px;background:var(--surface)}aside h2{font-size:16px;margin-top:0}dt{font-size:12px;color:var(--muted);margin-top:18px}dd{font-size:13px;margin:5px 0 0;overflow-wrap:anywhere}dd small{color:var(--muted)}aside>a{display:inline-block;margin-top:22px;font-size:13px}@media(max-width:800px){.detail-grid{grid-template-columns:1fr}aside{position:static;grid-row:1}}</style>