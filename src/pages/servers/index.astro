---
import Promotion from '../../components/Promotion.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Browse MCP servers — FreeMCP" description="Search and filter open-source MCP servers by name, category, and tags." canonicalPath="/servers/">
<section class="container directory" id="registry">
 <div class="eyebrow">EXPLORE / MCP SERVERS</div>
 <h1>Explore servers</h1>
 <p>Discover open-source integrations for your AI tools.</p>
 <form class="toolbar" method="get" action="/servers/">
  <div class="search-label"><label for="registry-query">Search servers</label>
   <span class="search-controls"><input id="registry-query" name="q" type="search" maxlength="120" placeholder="Search servers, tags, maintainers…" autocomplete="off"/><button type="submit">Search</button></span>
  </div>
  <label>Category<select id="registry-category" name="category"><option value="">All categories</option></select></label>
  <label>Sort<select id="registry-sort" name="sort"><option value="name">Name A–Z</option><option value="category">Category</option></select></label>
 </form>
 <p id="registry-count" role="status"></p>
 <Promotion placement="directory" />
 <div class="listing-shell"><div class="listing-head"><span>SERVER</span><span>CATEGORY</span><span>STATUS</span><span></span></div>
  <div id="registry-results" class="results">
   <div data-registry-start="0"></div>
   {[7, 14, 21].map(start => <>
    <div class="directory-inline-ad" data-inline-position={start}><Promotion placement="directory" slot="inline" /></div>
    <div data-registry-start={start}></div>
   </>)}
  </div>
 </div>
 <nav class="pagination" aria-label="Registry pages">
  <span id="previous-page"></span><span id="page-indicator"></span><span id="next-page"></span>
 </nav>
</section>
<script>
const form = document.querySelector<HTMLFormElement>('.toolbar');
for (const control of form?.querySelectorAll('select') ?? []) {
  control.addEventListener('change', () => form?.requestSubmit());
}
</script>
<style>
.results [data-registry-start]{display:contents}.search-label{display:flex;flex-direction:column;gap:8px}.search-controls{display:flex;gap:6px}.search-controls button{border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--text);padding:0 10px;cursor:pointer}.pagination :global(.page-link){text-decoration:none}.directory{padding:48px 0 100px}.eyebrow{color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.12em}h1{font-size:clamp(32px,4vw,46px);letter-spacing:-.04em;margin:12px 0 8px}.directory>p{color:var(--muted);line-height:1.5;margin:0}.toolbar{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr) minmax(0,1fr);gap:12px;margin:30px 0 18px}.toolbar label{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:600;color:var(--muted)}.toolbar input,.toolbar select{width:100%;min-width:0;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--text);padding:12px;font:inherit;font-size:13px}#registry-count{font-size:12px;color:var(--muted);margin:20px 0 12px}.listing-shell{border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface)}.listing-head{display:grid;grid-template-columns:minmax(0,1fr) 150px 160px 108px;gap:18px;padding:13px 20px;background:var(--bg);border-bottom:1px solid var(--border);font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--muted)}.results{display:block}.directory-inline-ad{padding:0 14px}.directory-inline-ad[hidden]{display:none}.results :global(.server-row){display:grid;grid-template-columns:minmax(0,1fr) 150px 160px 108px;gap:18px;align-items:center;padding:19px 20px;border-bottom:1px solid var(--border);transition:background .15s}.results :global([data-last-row]){border-bottom:0}.results :global(.server-row:hover){background:color-mix(in srgb,var(--accent) 5%,var(--surface))}.results :global(.server-identity){display:flex;align-items:flex-start;gap:14px;min-width:0}.results :global(.server-mark){display:grid;place-items:center;flex:0 0 40px;width:40px;height:40px;border:1px solid var(--border);border-radius:9px;background:var(--bg);color:var(--accent);font-size:18px;font-weight:800}.results :global(.server-main){min-width:0}.results :global(.server-main h2){font-size:14px;font-weight:700;margin:0 0 5px;line-height:1.35}.results :global(.server-main h2 a){text-decoration:none}.results :global(.server-main h2 a:hover){color:var(--accent)}.results :global(.server-description){font-size:12px;line-height:1.45;color:var(--muted);margin:0 0 5px;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}.results :global(.server-author){font-size:11px;color:var(--muted)}.results :global(.category-pill){display:inline-block;padding:5px 9px;border:1px solid var(--border);border-radius:5px;font-size:11px;color:var(--muted)}.results :global(.status-pill){display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600}.results :global(.status-pill:before){content:'';height:7px;width:7px;border-radius:50%;background:var(--muted)}.results :global(.archived){color:#e6b779}.results :global(.archived:before){background:#e6b779}.results :global(.unverified){color:var(--muted)}.results :global(.server-action){font-size:11px;font-weight:700;color:var(--accent);text-decoration:none;white-space:nowrap}.results :global(.server-action:hover){text-decoration:underline}.pagination{display:flex;justify-content:center;align-items:center;gap:20px;margin-top:30px}.pagination :global(.page-link){border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:7px;padding:10px 14px;cursor:pointer}.pagination :global(.page-link[aria-disabled=true]){opacity:.4;cursor:not-allowed}@media(max-width:760px){.listing-head{display:none}.results :global(.server-row){grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:17px 14px}.results :global(.server-identity){grid-column:1/-1}.results :global(.server-category){grid-column:1;grid-row:2;margin-left:54px}.results :global(.server-status){grid-column:2;grid-row:2}.results :global(.server-action){grid-column:1/-1;margin-left:54px;margin-top:2px}.results :global(.server-description){-webkit-line-clamp:2}.toolbar{grid-template-columns:1fr 1fr}.search-label{grid-column:1/-1}.directory{padding-top:34px}.pagination{gap:10px}}@media(max-width:380px){.results :global(.server-row){grid-template-columns:1fr}.results :global(.server-status),.results :global(.server-category),.results :global(.server-action){grid-column:1;grid-row:auto;margin-left:54px}}
</style>
<div slot="before-footer"><Promotion placement="directory" slot="footer" /></div>
</BaseLayout>
