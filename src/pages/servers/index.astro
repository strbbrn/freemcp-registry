---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Browse MCP servers — FreeMCP" description="Search and filter open-source MCP servers by name, category, and tags.">
<section class="container directory" id="registry">
 <div class="eyebrow">EXPLORE / MCP SERVERS</div>
 <h1>Explore servers</h1>
 <p>Discover open-source integrations for your AI tools.</p>
 <div class="toolbar"><label class="search-label">Search servers<input id="registry-query" type="search" placeholder="Search servers, tags, maintainers…" autocomplete="off"/></label><label>Category<select id="registry-category"><option value="">All categories</option></select></label><label>Sort<select id="registry-sort"><option value="name">Name A–Z</option><option value="category">Category</option></select></label></div>
 <p id="registry-count" role="status" aria-live="polite"></p>
 <div class="listing-shell"><div class="listing-head"><span>SERVER</span><span>CATEGORY</span><span>STATUS</span><span></span></div><div id="registry-results" class="results"></div></div>
 <nav class="pagination" aria-label="Registry pages"><button id="previous-page" type="button">← Previous</button><span id="page-indicator"></span><button id="next-page" type="button">Next →</button></nav>
 <noscript><p>JavaScript is required for interactive search. <a href="/v2-preview">Browse the static registry preview</a>.</p></noscript>
</section>
<script is:inline>
const size=24;
let requestNumber=0;
const search=document.getElementById('registry-query');
const category=document.getElementById('registry-category');
const sort=document.getElementById('registry-sort');
const results=document.getElementById('registry-results');
const count=document.getElementById('registry-count');
const previous=document.getElementById('previous-page');
const next=document.getElementById('next-page');
const indicator=document.getElementById('page-indicator');
const params=new URLSearchParams(location.search);
search.value=params.get('q')||'';
category.value=params.get('category')||'';
sort.value=params.get('sort')==='category'?'category':'name';
let page=Math.max(1,Number.parseInt(params.get('page')||'1',10)||1);
function element(tag,text,className){const node=document.createElement(tag);if(text!==undefined)node.textContent=text;if(className)node.className=className;return node;}
async function loadCategories(){
 try{
  const response=await fetch('/api/servers?meta=categories');
  if(!response.ok)throw new Error('Categories unavailable');
  const data=await response.json();
  for(const name of data.categories||[]){const option=element('option',name);option.value=name;category.append(option);}
  category.value=params.get('category')||'';
 }catch(error){console.warn('Could not load categories',error);}
 await render();
}
async function render(){
 const currentRequest=++requestNumber;
 count.textContent='Loading servers…';
 const query=new URLSearchParams({page:String(page),sort:sort.value});
 if(search.value.trim())query.set('q',search.value.trim());
 if(category.value)query.set('category',category.value);
 try{
  const response=await fetch('/api/servers?'+query);
  if(!response.ok)throw new Error('HTTP '+response.status);
  const data=await response.json();
  if(currentRequest!==requestNumber)return;
  const visible=data.servers||[];
  const total=data.total||0;
  const pages=data.pages||1;
  page=data.page||1;
  const url=new URL(location.href);
  for(const key of ['q','category','sort','page'])url.searchParams.delete(key);
  if(search.value.trim())url.searchParams.set('q',search.value.trim());
  if(category.value)url.searchParams.set('category',category.value);
  if(sort.value!=='name')url.searchParams.set('sort',sort.value);
  if(page>1)url.searchParams.set('page',String(page));
  history.replaceState(null,'',url);
  results.replaceChildren();
  for(const s of visible){
   const row=element('article',undefined,'server-row');
   const identity=element('div',undefined,'server-identity');
   const mark=element('span',(s.name||'?').trim().charAt(0).toUpperCase(),'server-mark');mark.setAttribute('aria-hidden','true');
   const main=element('div',undefined,'server-main');
   const title=element('h2');const link=element('a',s.name);link.href='/servers/'+encodeURIComponent(s.id);title.append(link);
   const subtitle=element('p',s.description,'server-description');
   const maintainer=element('span','by '+s.author,'server-author');
   main.append(title,subtitle,maintainer);identity.append(mark,main);
   const categoryCell=element('div',undefined,'server-category');categoryCell.append(element('span',s.category,'category-pill'));
   const status=element('div',undefined,'server-status');
   const isArchived=s.lifecycle==='archived';
   if(isArchived){
    const state=element('span','Archived','status-pill archived');
    state.title='Legacy implementation marked archived';
    status.append(state);
   }
   const action=element('a','View details →','server-action');action.href=link.href;action.setAttribute('aria-label','View '+s.name+' details');
   row.append(identity,categoryCell,status,action);results.append(row);
  }
  if(!total)results.append(element('p','No matching servers. Try a different search or category.'));
  count.textContent=total+' matching servers · showing '+(total?(page-1)*24+1:0)+'–'+Math.min(page*24,total);
  indicator.textContent='Page '+page+' of '+pages;
  previous.disabled=page<=1;next.disabled=page>=pages;
 }catch(error){
  if(currentRequest!==requestNumber)return;
  results.replaceChildren(element('p','The registry is temporarily unavailable. Please try again shortly.'));
  count.textContent='Unable to load servers';
  indicator.textContent='';previous.disabled=true;next.disabled=true;
  console.error('Registry request failed',error);
 }
}

[search,category,sort].forEach(control=>control.addEventListener(control===search?'input':'change',()=>{page=1;render()}));
previous.addEventListener('click',()=>{page--;render();document.getElementById('registry')?.scrollIntoView()});
next.addEventListener('click',()=>{page++;render();document.getElementById('registry')?.scrollIntoView()});
window.addEventListener('popstate',()=>{const p=new URLSearchParams(location.search);search.value=p.get('q')||'';category.value=p.get('category')||'';sort.value=p.get('sort')==='category'?'category':'name';page=Number.parseInt(p.get('page')||'1',10)||1;render()});
loadCategories();
</script>
<style>
.directory{padding:48px 0 100px}.eyebrow{color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.12em}h1{font-size:clamp(32px,4vw,46px);letter-spacing:-.04em;margin:12px 0 8px}.directory>p{color:var(--muted);line-height:1.5;margin:0}.toolbar{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr) minmax(0,1fr);gap:12px;margin:30px 0 18px}.toolbar label{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:600;color:var(--muted)}.toolbar input,.toolbar select{width:100%;min-width:0;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--text);padding:12px;font:inherit;font-size:13px}#registry-count{font-size:12px;color:var(--muted);margin:20px 0 12px}.listing-shell{border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--surface)}.listing-head{display:grid;grid-template-columns:minmax(0,1fr) 150px 160px 108px;gap:18px;padding:13px 20px;background:var(--bg);border-bottom:1px solid var(--border);font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--muted)}.results{display:block}.results :global(.server-row){display:grid;grid-template-columns:minmax(0,1fr) 150px 160px 108px;gap:18px;align-items:center;padding:19px 20px;border-bottom:1px solid var(--border);transition:background .15s}.results :global(.server-row:last-child){border-bottom:0}.results :global(.server-row:hover){background:color-mix(in srgb,var(--accent) 5%,var(--surface))}.results :global(.server-identity){display:flex;align-items:flex-start;gap:14px;min-width:0}.results :global(.server-mark){display:grid;place-items:center;flex:0 0 40px;width:40px;height:40px;border:1px solid var(--border);border-radius:9px;background:var(--bg);color:var(--accent);font-size:18px;font-weight:800}.results :global(.server-main){min-width:0}.results :global(.server-main h2){font-size:14px;font-weight:700;margin:0 0 5px;line-height:1.35}.results :global(.server-main h2 a){text-decoration:none}.results :global(.server-main h2 a:hover){color:var(--accent)}.results :global(.server-description){font-size:12px;line-height:1.45;color:var(--muted);margin:0 0 5px;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden}.results :global(.server-author){font-size:11px;color:var(--muted)}.results :global(.category-pill){display:inline-block;padding:5px 9px;border:1px solid var(--border);border-radius:5px;font-size:11px;color:var(--muted)}.results :global(.status-pill){display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600}.results :global(.status-pill:before){content:'';height:7px;width:7px;border-radius:50%;background:var(--muted)}.results :global(.archived){color:#e6b779}.results :global(.archived:before){background:#e6b779}.results :global(.unverified){color:var(--muted)}.results :global(.server-action){font-size:11px;font-weight:700;color:var(--accent);text-decoration:none;white-space:nowrap}.results :global(.server-action:hover){text-decoration:underline}.pagination{display:flex;justify-content:center;align-items:center;gap:20px;margin-top:30px}.pagination button{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:7px;padding:10px 14px;cursor:pointer}.pagination button:disabled{opacity:.4;cursor:not-allowed}@media(max-width:760px){.listing-head{display:none}.results :global(.server-row){grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:17px 14px}.results :global(.server-identity){grid-column:1/-1}.results :global(.server-category){grid-column:1;grid-row:2;margin-left:54px}.results :global(.server-status){grid-column:2;grid-row:2}.results :global(.server-action){grid-column:1/-1;margin-left:54px;margin-top:2px}.results :global(.server-description){-webkit-line-clamp:2}.toolbar{grid-template-columns:1fr 1fr}.search-label{grid-column:1/-1}.directory{padding-top:34px}.pagination{gap:10px}}@media(max-width:380px){.results :global(.server-row){grid-template-columns:1fr}.results :global(.server-status),.results :global(.server-category),.results :global(.server-action){grid-column:1;grid-row:auto;margin-left:54px}}
</style>
</BaseLayout>
