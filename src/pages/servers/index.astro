---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Browse MCP servers — FreeMCP" description="Search and filter open-source MCP servers by name, category, and tags.">
<section class="container directory" id="registry">
 <div class="eyebrow">THE REGISTRY</div>
 <h1>Browse MCP servers</h1>
 <p>Search by name, description, tag, or maintainer. Browse categories and sort results.</p>
 <div class="toolbar"><label class="search-label">Search servers<input id="registry-query" type="search" placeholder="Search servers, tags, maintainers…" autocomplete="off"/></label><label>Category<select id="registry-category"><option value="">All categories</option></select></label><label>Sort<select id="registry-sort"><option value="name">Name A–Z</option><option value="category">Category</option></select></label></div>
 <p id="registry-count" role="status" aria-live="polite"></p>
 <div id="registry-results" class="results"></div>
 <nav class="pagination" aria-label="Registry pages"><button id="previous-page" type="button">← Previous</button><span id="page-indicator"></span><button id="next-page" type="button">Next →</button></nav>
 <noscript><p>JavaScript is required for interactive search. <a href="/v2-preview">Browse the static registry preview</a>.</p></noscript>
</section>
<script is:inline>
const size=24;
let requestNumber=0;
const search=document.getElementById('registry-query');
const category=document.getElementById('registry-category');
const sort=document.getElementById('registry-sort');
const results=document.getElementById('registry-results');
const count=document.getElementById('registry-count');
const previous=document.getElementById('previous-page');
const next=document.getElementById('next-page');
const indicator=document.getElementById('page-indicator');
const params=new URLSearchParams(location.search);
search.value=params.get('q')||'';
category.value=params.get('category')||'';
sort.value=params.get('sort')==='category'?'category':'name';
let page=Math.max(1,Number.parseInt(params.get('page')||'1',10)||1);
function element(tag,text,className){const node=document.createElement(tag);if(text!==undefined)node.textContent=text;if(className)node.className=className;return node;}
async function loadCategories(){
 try{
  const response=await fetch('/api/servers?meta=categories');
  if(!response.ok)throw new Error('Categories unavailable');
  const data=await response.json();
  for(const name of data.categories||[]){const option=element('option',name);option.value=name;category.append(option);}
  category.value=params.get('category')||'';
 }catch(error){console.warn('Could not load categories',error);}
 await render();
}
async function render(){
 const currentRequest=++requestNumber;
 count.textContent='Loading servers…';
 const query=new URLSearchParams({page:String(page),sort:sort.value});
 if(search.value.trim())query.set('q',search.value.trim());
 if(category.value)query.set('category',category.value);
 try{
  const response=await fetch('/api/servers?'+query);
  if(!response.ok)throw new Error('HTTP '+response.status);
  const data=await response.json();
  if(currentRequest!==requestNumber)return;
  const visible=data.servers||[];
  const total=data.total||0;
  const pages=data.pages||1;
  page=data.page||1;
  const url=new URL(location.href);
  for(const key of ['q','category','sort','page'])url.searchParams.delete(key);
  if(search.value.trim())url.searchParams.set('q',search.value.trim());
  if(category.value)url.searchParams.set('category',category.value);
  if(sort.value!=='name')url.searchParams.set('sort',sort.value);
  if(page>1)url.searchParams.set('page',String(page));
  history.replaceState(null,'',url);
  results.replaceChildren();
  for(const s of visible){
   const article=element('article',undefined,'result-card');
   const meta=element('span',s.category,'result-meta');
   const title=element('h2');const link=element('a',s.name);link.href='/servers/'+encodeURIComponent(s.id);title.append(link);
   const desc=element('p',s.description);
   const author=element('small','by '+s.author);
   article.append(meta,title,desc,author);results.append(article);
  }
  if(!total)results.append(element('p','No matching servers. Try a different search or category.'));
  count.textContent=total+' matching servers · showing '+(total?(page-1)*24+1:0)+'–'+Math.min(page*24,total);
  indicator.textContent='Page '+page+' of '+pages;
  previous.disabled=page<=1;next.disabled=page>=pages;
 }catch(error){
  if(currentRequest!==requestNumber)return;
  results.replaceChildren(element('p','The registry is temporarily unavailable. Please try again shortly.'));
  count.textContent='Unable to load servers';
  indicator.textContent='';previous.disabled=true;next.disabled=true;
  console.error('Registry request failed',error);
 }
}

[search,category,sort].forEach(control=>control.addEventListener(control===search?'input':'change',()=>{page=1;render()}));
previous.addEventListener('click',()=>{page--;render();document.getElementById('registry')?.scrollIntoView()});
next.addEventListener('click',()=>{page++;render();document.getElementById('registry')?.scrollIntoView()});
window.addEventListener('popstate',()=>{const p=new URLSearchParams(location.search);search.value=p.get('q')||'';category.value=p.get('category')||'';sort.value=p.get('sort')==='category'?'category':'name';page=Number.parseInt(p.get('page')||'1',10)||1;render()});
loadCategories();
</script>
<style>
.directory{padding:64px 0 100px}.eyebrow{color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.14em}h1{font-size:clamp(36px,5vw,58px);letter-spacing:-.05em;margin:12px 0}.directory>p{color:var(--muted);line-height:1.7}.toolbar{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr) minmax(0,1fr);gap:12px;margin:34px 0 18px}.toolbar label{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:700}.toolbar input,.toolbar select{width:100%;min-width:0;border:1px solid var(--border);border-radius:9px;background:var(--surface);color:var(--text);padding:12px;font:inherit}.results{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,290px),1fr));gap:14px;margin:24px 0}.result-card{padding:22px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.result-meta{color:var(--accent);font-size:12px}.result-card h2{font-size:18px;margin:18px 0 10px}.result-card h2 a{text-decoration:none}.result-card p{color:var(--muted);font-size:13px;line-height:1.6}.result-card small{color:var(--muted)}.pagination{display:flex;justify-content:center;align-items:center;gap:20px;margin-top:36px}.pagination button{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:8px;padding:11px 15px;cursor:pointer}.pagination button:disabled{opacity:.4;cursor:not-allowed}@media(max-width:650px){.toolbar{grid-template-columns:1fr}.directory{padding-top:42px}.pagination{gap:10px}}
</style>
</BaseLayout>
