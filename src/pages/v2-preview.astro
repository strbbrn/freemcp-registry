---
import BaseLayout from '../layouts/BaseLayout.astro';
import registry from '../data/registry.json';
const categories=[...new Set(registry.map(s=>s.category))];
---
<BaseLayout title="FreeMCP 2.0 — Design Preview"><section class="container hero"><div class="eyebrow">FREEMCP 2.0 · PREVIEW</div><h1>Discover tools.<br/><span>Build better agents.</span></h1><p>A curated home for free and open-source MCP servers. Find the right integration, understand its capabilities, and get started with confidence.</p><a class="submit-link" href="#catalog">Explore servers →</a></section><section class="container" id="catalog"><div class="catalog-top"><div><div class="eyebrow">THE REGISTRY</div><h2>Explore MCP servers</h2><p>{registry.length} servers · {categories.length} categories</p></div><input id="search" type="search" placeholder="Search servers…" aria-label="Search servers"/></div><div class="filters"><button class="filter active" data-category="All" aria-pressed="true">All</button>{categories.map(c=><button class="filter" data-category={c} aria-pressed="false">{c}</button>)}</div><div class="grid">{registry.map(s=><article class="server" data-category={s.category} data-search={(s.name+' '+s.description+' '+s.tags.join(' ')).toLowerCase()}><div class="meta"><span>{s.category}</span><span>★ {s.stars.toLocaleString('en-US')}</span></div><h3>{s.name}</h3><small>by {s.author}</small><p>{s.description}</p><div class="tags">{s.tags.slice(0,3).map(t=><span>{t}</span>)}</div><a href={s.githubUrl} target="_blank" rel="noopener noreferrer">View repository ↗</a></article>)}</div><p id="empty" hidden>No matching servers.</p></section></BaseLayout>
<script>const search=document.querySelector('#search');const filters=document.querySelectorAll('.filter');const cards=document.querySelectorAll('.server');const empty=document.querySelector('#empty');let category='All';function refresh(){let count=0;const q=(search?.value||'').toLowerCase().trim();cards.forEach(c=>{const visible=(category==='All'||c.dataset.category===category)&&(!q||c.dataset.search?.includes(q));c.hidden=!visible;if(visible)count++});if(empty)empty.hidden=count!==0}search?.addEventListener('input',refresh);filters.forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category||'All';filters.forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b))});refresh()}))</script>
<style>.hero{padding:100px 0 95px;border-bottom:1px solid var(--border)}.eyebrow{color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.14em}.hero h1{font-size:clamp(38px,6vw,76px);line-height:1.06;letter-spacing:-.065em;margin:24px 0}.hero h1 span{color:var(--muted)}.hero p{max-width:590px;line-height:1.7;color:var(--muted);margin-bottom:32px}.catalog-top{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:52px 0 24px}.catalog-top h2{font-size:28px;letter-spacing:-.04em;margin:10px 0}.catalog-top p{color:var(--muted);font-size:13px}.catalog-top input{padding:13px 15px;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:9px;width:320px;max-width:100%}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.filter{padding:9px 12px;border:1px solid var(--border);border-radius:8px;background:transparent;color:var(--muted);cursor:pointer}.filter.active{color:var(--text);border-color:var(--accent);background:var(--surface)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,310px),1fr));gap:14px}.server{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:22px;display:flex;flex-direction:column;min-height:290px}.server[hidden]{display:none}.meta{display:flex;justify-content:space-between;font-size:11px;color:var(--accent)}.server h3{font-size:17px;letter-spacing:-.025em;margin:24px 0 5px}.server small{color:var(--muted)}.server p{color:var(--muted);font-size:13px;line-height:1.7;flex:1}.tags{display:flex;gap:5px;flex-wrap:wrap;margin:10px 0 18px}.tags span{font-size:11px;padding:5px 8px;background:var(--bg);border-radius:5px;color:var(--muted)}.server a{color:var(--accent);font-size:12px;text-decoration:none;font-weight:700}@media(max-width:650px){.hero{padding:65px 0}.catalog-top{flex-direction:column;align-items:stretch}.catalog-top input{width:100%}}</style>