---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServerDirectory from '../components/registry/ServerDirectory.astro';
import {validateRegistry} from '../lib/registry';
const registryErrors=validateRegistry();
if(registryErrors.length) throw new Error('Invalid MCP registry: '+registryErrors.join('; '));
---
<BaseLayout title="FreeMCP 2.0 — Design Preview" description="Explore free and open-source MCP servers with FreeMCP 2.0."><section class="container hero"><div class="eyebrow">FREEMCP 2.0 · PREVIEW</div><h1>Discover tools.<br/><span>Build better agents.</span></h1><p>A curated home for free and open-source MCP servers. Find the right integration, understand its capabilities, and get started with confidence.</p><a class="submit-link" href="#registry">Explore servers →</a></section><ServerDirectory/></BaseLayout>
<style>.hero{padding:100px 0 95px;border-bottom:1px solid var(--border)}.eyebrow{color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.14em}.hero h1{font-size:clamp(38px,6vw,76px);line-height:1.06;letter-spacing:-.065em;margin:24px 0}.hero h1 span{color:var(--muted)}.hero p{max-width:590px;line-height:1.7;color:var(--muted);margin-bottom:32px}@media(max-width:650px){.hero{padding:65px 0}}</style>