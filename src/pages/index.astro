---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="FreeMCP 2.0 — Open-source MCP server registry" description="Discover and explore open-source Model Context Protocol servers.">
  <section class="container hero">
    <div class="eyebrow">FREEMCP 2.0</div>
    <h1>Discover tools.<span> Build better agents.</span></h1>
    <p>Explore a curated registry of open-source MCP servers, inspect installation guidance, and submit projects for community review.</p>
    <div class="hero-actions"><a class="submit-link" href="#registry">Explore servers</a><a class="submit-link secondary" href="/submit">Submit a server</a></div>
  </section>
  <section class="container featured" id="registry">
    <div class="section-head"><div><div class="eyebrow">FRESH FROM THE COMMUNITY</div><h2>Recently added MCP servers</h2><p id="registry-summary" aria-live="polite">Loading the live registry…</p></div><a class="submit-link" href="/servers">Browse all servers →</a></div>
    <div class="featured-grid" id="recent-servers" aria-live="polite"><p class="loading-message">Loading recently added servers…</p></div>
  </section>
  <section class="container getting-started" id="how-it-works"><h2>Getting started</h2><p>Browse the registry, review a server's documentation and security considerations, then configure your MCP client using maintainer-backed instructions.</p><a href="/servers">Find an MCP server →</a></section>
<script is:inline>
(async () => {
 const grid=document.getElementById('recent-servers');
 const summary=document.getElementById('registry-summary');
 const make=(tag,cls,value)=>{const el=document.createElement(tag);if(cls)el.className=cls;if(value!=null)el.textContent=value;return el;};
 try {
  const [serverResponse,categoryResponse]=await Promise.all([fetch('/api/servers?sort=newest&page=1'),fetch('/api/servers?meta=categories')]);
  if(!serverResponse.ok||!categoryResponse.ok)throw new Error('Registry unavailable');
  const [data,categories]=await Promise.all([serverResponse.json(),categoryResponse.json()]);
  if(!Array.isArray(data.servers)||!Number.isInteger(data.total)||!Array.isArray(categories.categories))throw new Error('Unexpected registry response');
  summary.textContent=`${data.total} servers across ${categories.categories.length} categories`;
  grid.replaceChildren();
  for(const server of data.servers.slice(0,6)){
   const article=make('article','featured-card');
   const category=make('span','',server.category);
   const title=make('h3');
   const link=make('a','',server.name);
   link.href='/servers/'+encodeURIComponent(server.id);
   title.append(link);
   const description=make('p','',server.description);
   article.append(category,title,description);
   grid.append(article);
  }
  if(!data.servers.length)grid.append(make('p','loading-message','No published servers yet.'));
 } catch(error){
  console.warn('Live registry unavailable',error);
  summary.textContent='Live registry temporarily unavailable';
  grid.replaceChildren(make('p','loading-message','Unable to load servers right now. Please try again shortly.'));
 }
})();
</script>
</BaseLayout>
<style>
.hero{padding:96px 0 76px;border-bottom:1px solid var(--border)}
.eyebrow{color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.14em}
h1{font-size:clamp(38px,6vw,76px);line-height:1.08;letter-spacing:-.06em;margin:24px 0}
h1 span{color:var(--muted)}
.hero p{max-width:640px;color:var(--muted);line-height:1.7}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.hero-actions a{display:inline-flex;padding:12px 18px;text-decoration:none}
.secondary{background:transparent;border:1px solid var(--border);color:var(--text)}
@media(max-width:650px){.hero{padding:64px 0 55px}}
.featured{padding:64px 0}.section-head{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:25px}.section-head h2,.getting-started h2{font-size:28px;margin:10px 0}.section-head p,.getting-started p{color:var(--muted)}.featured-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.featured-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:22px}.featured-card span{font-size:12px;color:var(--accent)}.featured-card h3{margin:15px 0;font-size:18px}.featured-card h3 a{text-decoration:none}.featured-card p,.loading-message{font-size:13px;line-height:1.6;color:var(--muted)}.getting-started{padding:50px 0 90px;border-top:1px solid var(--border)}.getting-started p{max-width:650px;line-height:1.7}.getting-started a{color:var(--accent)}
</style>
