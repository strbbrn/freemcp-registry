---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="FreeMCP 2.0 — Open-source MCP server registry" description="Discover and explore open-source Model Context Protocol servers.">
  <section class="container hero">
    <div class="eyebrow">FREEMCP 2.0</div>
    <h1>Discover tools.<span> Build better agents.</span></h1>
    <p>Explore a curated registry of open-source MCP servers, inspect installation guidance, and submit projects for community review.</p>
    <div class="hero-actions"><a class="submit-link" href="#registry">Explore servers</a><a class="submit-link secondary" href="/submit">Submit a server</a></div>
  </section>
  <section class="container featured" id="registry">
    <div class="section-head"><div><div class="eyebrow">FRESH FROM THE COMMUNITY</div><h2>Recently added MCP servers</h2><p id="registry-summary" aria-live="polite">Loading the live registry…</p></div><a class="submit-link" href="/servers">Browse all servers →</a></div>
    <div class="featured-grid" id="recent-servers" aria-live="polite"><p class="loading-message">Loading recently added servers…</p></div>
  </section>
  <section class="container getting-started" id="how-it-works"><h2>Getting started</h2><p>Browse the registry, review a server's documentation and security considerations, then configure your MCP client using maintainer-backed instructions.</p><a href="/servers">Find an MCP server →</a></section>
<script is:inline>
(async () => {
 const grid=document.getElementById('recent-servers');
 const summary=document.getElementById('registry-summary');
 const make=(tag,cls,value)=>{const el=document.createElement(tag);if(cls)el.className=cls;if(value!=null)el.textContent=value;return el;};
 try {
  const [serverResponse,categoryResponse]=await Promise.all([fetch('/api/servers?sort=newest&page=1&limit=6'),fetch('/api/servers?meta=categories')]);
  if(!serverResponse.ok)throw new Error(`Servers API returned HTTP ${serverResponse.status}`);
  const data=await serverResponse.json();
  if(!Array.isArray(data.servers)||!Number.isInteger(data.total)||data.servers.length>6)throw new Error('Unexpected servers API response');
  let categoryCount=null;
  if(categoryResponse.ok){try{const categories=await categoryResponse.json();if(Array.isArray(categories.categories))categoryCount=categories.categories.length;}catch(e){console.warn('Category metadata unavailable',e);}}
  summary.textContent=categoryCount===null?`${data.total} servers in the live registry`:`${data.total} servers across ${categoryCount} categories`;
  grid.replaceChildren();
  for(const server of data.servers){
   const article=make('article','featured-card');
   const category=make('span','',server.category);
   const title=make('h3');
   const link=make('a','',server.name);
   link.href='/servers/'+encodeURIComponent(server.id);
   title.append(link);
   const description=make('p','',server.description);
   article.append(category,title,description);
   if(server.author)article.append(make('div','featured-author',`by ${server.author}`));
   grid.append(article);
  }
  if(!data.servers.length)grid.append(make('p','loading-message','No published servers yet.'));
 } catch(error){
  console.warn('Live registry unavailable',error);
  summary.textContent='Live registry temporarily unavailable';
  grid.replaceChildren(make('p','loading-message',`Unable to load servers ( ${error.message} ). Please try again shortly.`));
 }
})();
</script>
</BaseLayout>
<style>
.hero{padding:96px 0 76px;border-bottom:1px solid var(--border)}
.eyebrow{color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.14em}
h1{font-size:clamp(38px,6vw,76px);line-height:1.08;letter-spacing:-.06em;margin:24px 0}
h1 span{color:var(--muted)}
.hero p{max-width:640px;color:var(--muted);line-height:1.7}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
.hero-actions a{display:inline-flex;padding:12px 18px;text-decoration:none}
.secondary{background:transparent;border:1px solid var(--border);color:var(--text)}
@media(max-width:650px){.hero{padding:64px 0 55px}}
.featured{padding:64px 0}.section-head{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;margin-bottom:25px}.section-head h2,.getting-started h2{font-size:28px;margin:10px 0}.section-head p,.getting-started p{color:var(--muted)}.featured-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.featured-card{display:flex;flex-direction:column;position:relative;min-height:230px;background:linear-gradient(180deg,oklch(1 0 0 / 4%),oklch(1 0 0 / 1%));border:1px solid var(--border);border-radius:12px;padding:20px;transition:transform .2s,border-color .2s,box-shadow .2s}.featured-card:hover{transform:translateY(-2px);border-color:var(--accent);box-shadow:0 12px 40px -12px var(--glow)}.featured-card span{align-self:flex-start;font:11px 'Geist Mono',monospace;color:var(--muted);background:var(--secondary);border:1px solid var(--border);border-radius:100px;padding:4px 10px}.featured-card h3{margin:18px 0 8px;font-size:16px;font-weight:650;letter-spacing:-.025em}.featured-card h3 a{text-decoration:none}.featured-card p,.loading-message{font-size:14px;line-height:1.55;color:var(--muted)}.featured-author{margin-top:auto;padding-top:18px;font:12px 'Geist Mono',monospace;color:var(--muted)}.getting-started{padding:50px 0 90px;border-top:1px solid var(--border)}.getting-started p{max-width:650px;line-height:1.7}.getting-started a{color:var(--accent)}
</style>
