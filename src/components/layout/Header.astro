<a href="#main-content" class="skip-link">Skip to content</a><header class="site-header"><nav class="container site-nav" aria-label="Main navigation"><a href="/" class="brand">FreeMCP<span>.</span></a><div class="nav-links"><a href="/#registry">Explore</a><a href="/#how-it-works">Getting started</a><a href="https://github.com/strbbrn/freemcp-registry" target="_blank" rel="noopener noreferrer">GitHub</a></div><div class="nav-actions"><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme" aria-pressed="false">☾ Theme</button><a class="submit-link" href="https://github.com/strbbrn/freemcp-registry/issues/new?template=submit-server.md" target="_blank" rel="noopener noreferrer">+ Submit server</a></div></nav></header><script>const toggle=document.getElementById('theme-toggle');function setTheme(t){document.documentElement.dataset.theme=t;toggle?.setAttribute('aria-pressed',String(t==='light'));if(toggle)toggle.textContent=t==='light'?'☀ Theme':'☾ Theme'}try{setTheme(localStorage.getItem('freemcp-theme')==='light'?'light':'dark')}catch{setTheme('dark')}toggle?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='light'?'dark':'light';setTheme(next);try{localStorage.setItem('freemcp-theme',next)}catch{}})</script>