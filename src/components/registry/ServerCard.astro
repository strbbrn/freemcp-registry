---
import type { RegistryServer } from '../../lib/registry';
interface Props { server: RegistryServer }
const {server}=Astro.props;
---
<article class="server-card" data-category={server.category} data-search={(server.name+' '+server.description+' '+server.tags.join(' ')+' '+server.author).toLowerCase()}><div class="server-meta"><span>{server.category}</span><span title="Stored GitHub star count; may be outdated">★ {server.stars.toLocaleString('en-US')}</span></div><h3><a href={'/servers/'+server.id}>{server.name}</a></h3><small>by {server.author}</small><p>{server.description}</p><div class="server-tags">{server.tags.slice(0,3).map(tag=><span>{tag}</span>)}</div><div class="server-links"><a href={'/servers/'+server.id}>View details →</a><a href={server.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></article>
<style>.server-card{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:22px;display:flex;flex-direction:column;min-height:290px}.server-card[hidden]{display:none}.server-meta{display:flex;justify-content:space-between;font-size:11px;color:var(--accent)}h3{font-size:17px;letter-spacing:-.025em;margin:24px 0 5px}h3 a{text-decoration:none}h3 a:hover{color:var(--accent)}small{color:var(--muted)}p{color:var(--muted);font-size:13px;line-height:1.7;flex:1}.server-tags{display:flex;gap:5px;flex-wrap:wrap;margin:10px 0 18px}.server-tags span{font-size:11px;padding:5px 8px;background:var(--bg);border-radius:5px;color:var(--muted)}.server-links{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.server-links a{color:var(--accent);font-size:12px;text-decoration:none;font-weight:700}</style>