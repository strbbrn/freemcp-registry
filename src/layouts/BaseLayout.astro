---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/v2.css';
interface Props { title?:string; description?:string; canonicalPath?:string }
const {title='FreeMCP — Open-source MCP server registry',description='Discover free and open-source Model Context Protocol servers.',canonicalPath=Astro.url.pathname}=Astro.props;
const canonical=new URL(canonicalPath,'https://freemcp.in').toString();
---
<!doctype html><html lang="en" data-theme="dark"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#0b0d12"/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary"/><title>{title}</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><Header/><main id="main-content"><slot/></main><Footer/></body></html>